rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Collection-group queries require a version-2 recursive match. This grants
    // reads only to signed-in accounts carrying a server-issued admin claim.
    match /{path=**}/sessions/{sessionId} {
      allow read: if isAdmin();
    }

    match /participants/{uid}/sessions/{sessionId} {
      allow read: if (isOwner(uid) && resource.data.ownerUid == uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.ownerUid == uid;
      allow update: if isOwner(uid)
        && resource.data.ownerUid == uid
        && request.resource.data.ownerUid == uid;
      allow delete: if false;

      match /taskResults/{taskAttemptId} {
        allow read: if (isOwner(uid) && resource.data.ownerUid == uid) || isAdmin();
        allow create: if isOwner(uid) && request.resource.data.ownerUid == uid;
        allow update: if isOwner(uid)
          && resource.data.ownerUid == uid
          && request.resource.data.ownerUid == uid;
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if (isOwner(uid) && resource.data.ownerUid == uid) || isAdmin();
        allow create: if isOwner(uid) && request.resource.data.ownerUid == uid;
        allow update: if isOwner(uid)
          && resource.data.ownerUid == uid
          && request.resource.data.ownerUid == uid;
        allow delete: if false;
      }

      match /feedback/{feedbackId} {
        allow read: if (isOwner(uid) && resource.data.ownerUid == uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.sessionId == sessionId
          && exists(/databases/$(database)/documents/participants/$(uid)/sessions/$(sessionId));
        allow update: if isOwner(uid)
          && resource.data.ownerUid == uid
          && request.resource.data.ownerUid == uid
          && request.resource.data.sessionId == sessionId;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
